# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-secret-at-least-32-chars

# Database (Neon Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/covered?schema=public
# Optional direct URL for migrations when using a pooler
# DIRECT_URL=postgresql://user:pass@host/db?sslmode=require

# Resend (magic link email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Covered <onboarding@resend.dev>
# When true (or RESEND_API_KEY missing), magic links are logged to the server console
EMAIL_DEV_MODE=true

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=covered
R2_ENDPOINT=
NEXT_PUBLIC_R2_PUBLIC_URL=https://assets.covered.rejisterjack.com

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@covered.rejisterjack.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cron auth for /api/cron/*
CRON_SECRET=generate-a-cron-secret

# Admin role (comma-separated emails promoted to role=admin on sign-in)
ADMIN_EMAILS=

# Trust / moderation
FLAG_AUTO_THRESHOLD=3
POSTING_LOCK_UNCONFIRMED_THRESHOLD=3
CONFIRMATION_WINDOW_HOURS=24
